{
  "name": "suvakta",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.2",
    "@vinext/cloudflare": "1.0.0-beta.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "vinext": "1.0.0-beta.11",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3100",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 8788 --persist-to .wrangler/state",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:staging": "vinext-cloudflare deploy --env staging --config dist/server/wrangler.json",
    "deploy:production": "vinext-cloudflare deploy --env production --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dukaanos-dev --local",
    "db:migrate:staging": "wrangler d1 migrations apply dukaanos-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply dukaanos-prod --remote --env production",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "mobile:apk": "cd android && ./gradlew assembleDebug && echo 'APK: android/app/build/outputs/apk/debug/app-debug.apk'",
    "db:seed:local": "tsx scripts/seed.ts",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed:local",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "icons": "node scripts/generate-icons.mjs",
    "admin:create": "tsx scripts/create-super-admin.ts"
  }
}
